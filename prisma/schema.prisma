// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== AUTH MODELS (NextAuth) ====================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==================== APP MODELS ====================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  phone         String?
  password      String?   // Bcrypt hash cho đăng nhập email/mật khẩu
  role          Role      @default(USER) // USER | STAFF | ADMIN
  permissions   String[]  @default([])

  accounts         Account[]
  sessions         Session[]
  weddings         Wedding[]
  fileManagement   FileManagement[]
  contactRequests  ContactRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Wedding {
  id         String @id @default(cuid())
  slug       String @unique // URL: /w/thanhtung-huonggiang
  userId     String
  user       User   @relation(fields: [userId], references: [id])
  templateId String
  template   Template @relation(fields: [templateId], references: [id])

  // Status & Plan
  status    WeddingStatus @default(DRAFT)
  /// @deprecated Không còn dùng để khoá section theo gói — giữ lại để tương
  /// thích dữ liệu cũ. Số tiền thật sự đã trả nằm ở `purchasePrice`.
  plan      Plan          @default(FREE)
  paidAt    DateTime?
  expiresAt DateTime?
  /// Số tiền (VND) của lần thanh toán PUBLISH/RENEW/TEMPLATE_CHANGE gần nhất
  /// thành công — cộng dồn khi đổi sang template đắt hơn.
  purchasePrice Int?

  // Wedding Data
  groomName     String
  brideName     String
  groomParents  Json // { father: "", mother: "" }
  brideParents  Json
  groomCeremony Json // CeremonyEvent data
  brideCeremony Json
  quote         String?
  gallery       Json // Array of image URLs
  gifting       Json? // Bank account info

  // Custom Theme
  primaryColor    String? @default("#800020")
  accentColor     String? @default("#d4a853")
  backgroundColor String? // Nền trang (mặc định #faf8f5)
  textColor       String? @default("#4A4A4A") // Màu chữ chính
  fontFamily      String?
  typography      Json?   // Tuỳ chỉnh font (heading, body, script)
  sectionOrder    Json?   // ["header","wedding-info",...] — thứ tự khối
  backgroundMusic String? // URL to music file

  // SEO
  metaTitle       String?
  metaDescription String?
  ogImage         String?

  // Analytics
  viewCount Int @default(0)

  // Relations
  guests           Guest[]
  wishes           Wish[]
  payments         Payment[]
  fileManagement   FileManagement[]
  contactRequests  ContactRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([slug])
}

/// File đã upload (S3/MinIO hoặc local), gắn với thiệp + vị trí hiển thị (slotKey).
model FileManagement {
  id           String   @id @default(cuid())
  weddingId    String
  wedding      Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slotKey      String
  publicUrl    String
  storageKey   String
  originalName String?
  mimeType     String?
  sizeBytes    Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([weddingId, slotKey])
  @@index([userId])
  @@index([weddingId])
}

model Template {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String
  thumbnail   String
  previewUrl  String?
  category    String // "classic", "modern", "minimal", "luxury"
  /// @deprecated Không còn dùng để khoá section theo gói — giữ lại để tương
  /// thích dữ liệu cũ. Giá thật nằm ở `price`/`salePrice`.
  isPremium   Boolean @default(false)
  /// @deprecated Xem `isPremium`.
  minPlan     Plan    @default(FREE)
  config      Json // Template-specific config/sections

  // Giá bán, admin chỉnh trực tiếp trong dashboard (không cần deploy lại).
  price        Int // VND — giá gốc của template
  salePrice    Int? // VND — giá khuyến mãi, có hiệu lực trong [saleStartsAt, saleEndsAt]
  saleStartsAt DateTime?
  saleEndsAt   DateTime?

  weddings Wedding[]
  coupons  Coupon[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Guest {
  id        String @id @default(cuid())
  weddingId String
  wedding   Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  name       String
  salutation String? // "Anh", "Chị", "Cô", "Chú"
  phone      String?
  email      String?
  side       Side       @default(GROOM)
  group      String? // "Bạn đại học", "Đồng nghiệp"

  rsvpStatus     RSVPStatus @default(PENDING)
  rsvpAt         DateTime?
  numberOfGuests Int        @default(1)

  inviteLink   String?  @unique // Unique invite link per guest
  linkOpened   Boolean  @default(false)
  linkOpenedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([weddingId])
}

model Wish {
  id        String @id @default(cuid())
  weddingId String
  wedding   Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  guestId    String?
  name       String
  message    String
  attendance String? // "Tham dự" / "Rất tiếc không thể"
  isApproved Boolean @default(true) // Moderation

  createdAt DateTime @default(now())

  @@index([weddingId])
}

model Payment {
  id        String @id @default(cuid())
  weddingId String
  wedding   Wedding @relation(fields: [weddingId], references: [id])

  /// Loại giao dịch: xuất bản lần đầu, gia hạn, hay đổi sang template đắt hơn.
  type      PaymentType @default(PUBLISH)
  amount        Int // VND — số tiền thực thu (sau khuyến mãi/coupon)
  /// Giá hiệu lực của template (sau sale, trước coupon) tại thời điểm thanh toán.
  basePrice     Int?
  couponId      String?
  coupon        Coupon? @relation(fields: [couponId], references: [id])
  /// Số tiền (VND) đã được giảm nhờ coupon, dùng để đối soát.
  couponDiscount Int?
  /// Chỉ có giá trị khi `type = TEMPLATE_CHANGE` — template đích sẽ được áp
  /// dụng cho `wedding` khi thanh toán này COMPLETED.
  targetTemplateId String?
  /// @deprecated Không còn ghi cho giao dịch mới — giữ nullable để đọc lịch sử cũ.
  plan          Plan?
  method        String // "vnpay", "momo", "bank_transfer"
  transactionId String?
  status        PaymentStatus @default(PENDING)
  paidAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([weddingId])
  @@index([couponId])
}

enum PaymentType {
  PUBLISH
  RENEW
  TEMPLATE_CHANGE
}

/// Mã giảm giá áp dụng lúc thanh toán, độc lập với giá khuyến mãi trên Template.
model Coupon {
  id              String   @id @default(cuid())
  code            String   @unique
  discountType    CouponDiscountType
  /// VND nếu FIXED, 1-100 nếu PERCENT.
  discountValue   Int
  /// null = áp dụng cho mọi template.
  templateId      String?
  template        Template? @relation(fields: [templateId], references: [id])
  /// null = không giới hạn tổng số lượt dùng.
  maxRedemptions  Int?
  redemptionCount Int      @default(0)
  startsAt        DateTime?
  endsAt          DateTime?
  isActive        Boolean  @default(true)

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([templateId])
}

enum CouponDiscountType {
  FIXED
  PERCENT
}

/// Yêu cầu tư vấn từ khách hàng, gửi từ editor thiệp.
/// Đính kèm ngữ cảnh (mẫu đang dùng, các khối đang bật) để tư vấn đúng nhu cầu.
model ContactRequest {
  id        String  @id @default(cuid())
  userId    String?
  user      User?   @relation(fields: [userId], references: [id])
  weddingId String?
  wedding   Wedding? @relation(fields: [weddingId], references: [id])

  name    String
  phone   String
  message String
  context Json? // { templateSlug, enabledSections, plan }

  status ContactStatus @default(NEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([weddingId])
  @@index([status])
}

// ==================== ENUMS ====================

enum ContactStatus {
  NEW
  CONTACTED
  CLOSED
}

enum WeddingStatus {
  DRAFT
  DEMO
  PUBLISHED
  EXPIRED
}

enum Plan {
  FREE
  BASIC
  STANDARD
  PREMIUM
}

enum Side {
  GROOM
  BRIDE
}

enum RSVPStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum Role {
  USER
  STAFF
  ADMIN
}
