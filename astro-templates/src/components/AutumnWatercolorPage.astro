---
import "../static/autumn-watercolor.css";
import "../static/reveal.css";
import InvitationHeaderStaticAW from "../static/InvitationHeaderStaticAW.astro";
import WeddingInfoStaticAW from "../static/WeddingInfoStaticAW.astro";
import GalleryStaticAW from "../static/GalleryStatic.astro"; // Wait, GalleryStaticAW does not exist! Wait, Gallery is an island in AW.
import TimelineStaticAW from "../static/TimelineStaticAW.astro";
import GiftingStaticAW from "../static/GiftingStaticAW.astro";
import FooterStaticAW from "../static/FooterStaticAW.astro";
import ModeSwitcherStatic from "../static/ModeSwitcherStatic.astro";

import WeddingCardOpeningIslandAW from "../islands/WeddingCardOpeningIslandAW";
import GalleryIslandAW from "../islands/GalleryIslandAW";
import WishesSliderIslandAW from "../islands/WishesSliderIslandAW";
import BackgroundMusicIslandAW from "../islands/BackgroundMusicIslandAW";
import GuestViewTrackerIsland from "../islands/GuestViewTrackerIsland";

import { visibleSectionKeys } from "@/lib/section-config";
import type { StaticSiteInput } from "@/lib/static-site/types";

interface Props {
  input: StaticSiteInput;
}
const { input } = Astro.props;
const { wedding, mode, googleFontsUrl, headingFont, bodyFont, scriptFont } = input;

const isBrideMode = mode === "bride";
const DEFAULT_SECTIONS = [
  "header",
  "info",
  "gallery",
  "timeline",
  "wishes",
  "gifting",
  "footer",
];
const order = visibleSectionKeys(wedding.sectionOrder, DEFAULT_SECTIONS);

const themeVars = [
  `--primary:${wedding.accentColor ?? "#422114"}`,
  `--secondary:${wedding.primaryColor ?? "#b9856f"}`,
  `--bg-cream:${wedding.backgroundColor ?? "#f7f1eb"}`,
  `--font-heading:${headingFont}`,
  `--font-body:${bodyFont}`,
  `--font-script:${scriptFont}`,
].join(";");

const musicUrl = wedding.backgroundMusic || "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-17.mp3";
---
<!DOCTYPE html>
<html lang="vi" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Thiệp Cưới {wedding.groomName} & {wedding.brideName}</title>
    {googleFontsUrl && <link href={googleFontsUrl} rel="stylesheet" />}
  </head>
  <body>
    <div
      class="autumn-watercolor-root min-h-screen relative"
      style={`${themeVars}; font-family: var(--font-body)`}
    >
      <WeddingCardOpeningIslandAW
        client:load
        groomName={wedding.groomName}
        brideName={wedding.brideName}
        isBrideMode={isBrideMode}
      />
      
      <BackgroundMusicIslandAW client:load url={musicUrl} />

      <ModeSwitcherStatic mode={mode} />

      <main
        class="max-w-[500px] mx-auto shadow-xl overflow-hidden relative"
        style="background-color: var(--bg-cream)"
      >
        {/* Decorative Watercolor Header */}
        <div class="absolute top-0 left-0 w-full h-[300px] pointer-events-none watercolor-decor opacity-40 overflow-hidden">
           <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg" class="absolute -top-10 -left-10 w-48 h-48" style="fill: var(--secondary)">
             <path d="M44.7,-76.4C58.2,-69.2,69.5,-57.4,77.4,-44.1C85.3,-30.8,89.7,-15.8,90.3,0.3C90.9,16.4,87.6,33.3,79.5,47.9C71.4,62.5,58.6,74.7,43.9,81.4C29.2,88.1,12.6,89.2,-2.9,94.2C-18.4,99.2,-36.8,108.1,-52,104.2C-67.2,100.3,-79.1,83.5,-87,66.6C-94.9,49.7,-98.7,32.7,-98.8,16.2C-98.9,-0.3,-95.2,-16.2,-88,-31C-80.8,-45.8,-70.1,-59.5,-57,-66.9C-43.9,-74.3,-28.4,-75.4,-14.2,-79.3C0,-83.1,14.2,-89.6,29.9,-85C45.6,-80.4,62.8,-64.8,44.7,-76.4Z" transform="translate(100 100)" />
           </svg>
        </div>

        {order.map((id) => {
          switch (id) {
            case "header":
              return (
                <div data-section={id}>
                  <InvitationHeaderStaticAW wedding={wedding} mode={mode} />
                </div>
              );
            case "info":
              return (
                <div data-section={id} class="py-16 px-6 relative z-10">
                  <WeddingInfoStaticAW wedding={wedding} mode={mode} />
                </div>
              );
            case "gallery":
              return (
                <div data-section={id} class="py-16 px-6 relative z-10">
                  <GalleryIslandAW client:load images={wedding.gallery} weddingId={wedding.id} />
                </div>
              );
            case "timeline":
              return (
                <div data-section={id} class="py-16 px-6 relative z-10">
                  <TimelineStaticAW wedding={wedding} mode={mode} />
                </div>
              );
            case "wishes":
              return (
                <div data-section={id} class="py-16 px-4 sm:px-6 relative z-10 bg-[color-mix(in_srgb,var(--primary)_5%,transparent)]">
                  <WishesSliderIslandAW client:load weddingId={wedding.id} />
                </div>
              );
            case "gifting":
              return (
                <div data-section={id} class="py-16 px-6 relative z-10">
                  <GiftingStaticAW wedding={wedding} mode={mode} />
                </div>
              );
            case "footer":
              return (
                <div data-section={id}>
                  <FooterStaticAW wedding={wedding} mode={mode} />
                </div>
              );
            default:
              return null;
          }
        })}
      </main>

      <GuestViewTrackerIsland client:load weddingSlug={wedding.slug} />
    </div>
    
    <script src="../static/reveal-observer.js"></script>
    <script src="../static/guest-personalize.js"></script>
  </body>
</html>
