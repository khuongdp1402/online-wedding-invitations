---
import type { WeddingData } from "@/lib/template-registry";
import Reveal from "./Reveal.astro";

interface Props {
  wedding: WeddingData;
  mode: "groom" | "bride";
}
const { wedding, mode } = Astro.props;
---
<footer class="py-20 px-6 text-center space-y-6 relative overflow-hidden">
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-32 h-px bg-[color-mix(in_srgb,var(--secondary)_30%,transparent)]"></div>
  
  <Reveal y={20}>
    <div class="space-y-2">
      <p class="font-script text-4xl text-[var(--primary)]">Thank You</p>
      <p class="text-sm opacity-60 tracking-widest uppercase">Trân trọng cảm ơn</p>
    </div>

    <p class="text-xs opacity-40 max-w-[200px] mx-auto italic mt-6">
      Sự diện hiện của quý vị là món quà ý nghĩa nhất đối với chúng tôi.
    </p>

    {/* Decorative leaf footer */}
    <div class="pt-10 opacity-30">
      <svg width="40" height="40" viewBox="0 0 100 100" class="mx-auto fill-[var(--secondary)]">
         <path d="M50,10 C60,40 80,40 50,90 C20,40 40,40 50,10" />
      </svg>
    </div>

    <div class="pt-10">
      <p class="text-[10px] opacity-30 uppercase tracking-[0.4em]">© 2026 {wedding.groomName} & {wedding.brideName}</p>
    </div>

    {wedding.status !== "PUBLISHED" && (
      <div class="pt-2">
        <div class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white/80 backdrop-blur-sm rounded-full shadow-sm border border-black/5">
          <span class="text-[10px] font-medium text-black/60 tracking-wider">Tạo bởi</span>
          <img src="/logo-icon.png" alt="Logo" class="w-3.5 h-3.5 opacity-80" />
          <span class="text-[10px] font-bold text-black/80 tracking-wide">ThiepCuoiOnline.vn</span>
        </div>
      </div>
    )}
  </Reveal>
</footer>
