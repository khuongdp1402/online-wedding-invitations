---
import type { WeddingData } from "@/lib/template-registry";
import Reveal from "./Reveal.astro";

interface Props {
  wedding: WeddingData;
  mode: "groom" | "bride";
}
const { wedding, mode } = Astro.props;
const isBrideMode = mode === "bride";
const groom = { name: wedding.groomName, parents: wedding.groomParents };
const bride = { name: wedding.brideName, parents: wedding.brideParents };
---
<Reveal y={20}>
  <div class="space-y-16 text-center">
    {/* Parents Info */}
    <div class="grid grid-cols-2 gap-8 relative">
      <div class="space-y-2">
        <p class="font-bold text-xs uppercase tracking-widest opacity-50">Nhà trai</p>
        <div class="text-sm space-y-1">
          <p>Bố: {groom.parents.father}</p>
          <p>Mẹ: {groom.parents.mother}</p>
        </div>
        <p class="font-script text-2xl mt-4">{groom.name}</p>
      </div>
      
      <div class="h-24 w-px bg-gray-200 absolute left-1/2 top-4"></div>

      <div class="space-y-2">
        <p class="font-bold text-xs uppercase tracking-widest opacity-50">Nhà gái</p>
        <div class="text-sm space-y-1">
          <p>Bố: {bride.parents.father}</p>
          <p>Mẹ: {bride.parents.mother}</p>
        </div>
        <p class="font-script text-2xl mt-4">{bride.name}</p>
      </div>
    </div>

    {/* Ceremony Details */}
    <div class="pt-8 space-y-8">
      <div class="inline-block p-1 border border-[color-mix(in_srgb,var(--secondary)_30%,transparent)]">
        <div class="border border-[color-mix(in_srgb,var(--secondary)_10%,transparent)] p-4">
           <p class="font-script text-3xl mb-2">Save the Date</p>
           <p class="text-2xl font-bold">10 . 05 . 2026</p>
           <p class="text-xs uppercase tracking-widest opacity-60">(10 tháng 4 năm Bính Ngọ)</p>
        </div>
      </div>

      <div class="space-y-4">
        <p class="font-script text-3xl text-[var(--secondary)]">Wedding Ceremony</p>
        <div class="space-y-2 text-sm italic opacity-80">
          <p>{isBrideMode ? wedding.brideCeremony.ceremonyTime : wedding.groomCeremony.ceremonyTime}</p>
          <p class="font-bold uppercase not-italic tracking-tighter text-lg">
            {isBrideMode ? wedding.brideCeremony.venue : wedding.groomCeremony.venue}
          </p>
          <p>{isBrideMode ? wedding.brideCeremony.address : wedding.groomCeremony.address}</p>
        </div>
      </div>
    </div>
  </div>
</Reveal>
