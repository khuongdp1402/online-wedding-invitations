---
// Port từ components/templates/classic-burgundy/InvitationHeader.tsx.
// Bỏ useEditOverlay/editSlotClass (không cần ở public); next/image -> <img>.
import Reveal from "./Reveal.astro";
import type { WeddingData } from "@/types/template";

interface Props {
  wedding: WeddingData;
  mode: "groom" | "bride";
}
const { wedding, mode } = Astro.props;
const isBrideMode = mode === "bride";
const firstName = isBrideMode ? wedding.brideName : wedding.groomName;
const secondName = isBrideMode ? wedding.groomName : wedding.brideName;
const ceremony = isBrideMode ? wedding.brideCeremony : wedding.groomCeremony;
const heroImage = wedding.gallery[0] ?? "";
---
<section id="top" class="relative min-h-screen min-h-[100dvh] overflow-hidden p-0">
  <!-- MOBILE -->
  <div class="lg:hidden relative w-full h-full min-h-screen min-h-[100dvh]">
    <div class="absolute inset-0">
      <img src={heroImage} alt="Ảnh nền thiệp cưới" class="w-full h-full object-cover object-[60%_50%]" loading="eager" />
      <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/25 to-transparent pointer-events-none" aria-hidden="true"></div>
    </div>
    <div class="absolute inset-0 z-10 flex flex-col justify-end pt-[max(env(safe-area-inset-top),0.75rem)] pb-[max(env(safe-area-inset-bottom),2rem)] pl-[max(env(safe-area-inset-left),1rem)] pr-[max(env(safe-area-inset-right),1rem)]">
      <div class="max-w-xl mx-auto w-full">
        <Reveal y={20}>
          <div class="mb-2 sm:mb-3 text-center">
            <svg class="w-6 h-6 sm:w-8 sm:h-8 cb-text-accent mx-auto" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.29 1.51 4.04 3 5.5l7 7Z"/></svg>
          </div>
        </Reveal>
        <Reveal delay={0.1}>
          <h2 class="cb-text-accent text-[10px] sm:text-xs tracking-[0.35em] uppercase font-bold mb-2 sm:mb-4 text-center">
            {isBrideMode ? "Tân Nương & Tân Lang" : "Tân Lang & Tân Nương"}
          </h2>
        </Reveal>
        <Reveal delay={0.2} class="mb-4 sm:mb-6">
          <div class="flex items-center justify-between gap-4 w-full">
            <h1 class="text-2xl sm:text-4xl lg:text-5xl font-script cb-text-accent font-bold leading-tight drop-shadow-sm shrink-0">{firstName}</h1>
            <h1 class="text-2xl sm:text-4xl lg:text-5xl font-script cb-text-accent font-bold leading-tight drop-shadow-sm shrink-0">{secondName}</h1>
          </div>
        </Reveal>
        <Reveal delay={0.5}>
          <div class="flex flex-col items-center gap-2 sm:gap-4 w-full">
            <p class="cb-text-accent text-[10px] sm:text-xs tracking-[0.25em] uppercase font-semibold">Save the date</p>
            <div class="h-px w-16 sm:w-24 mx-auto" style="background-color: var(--cb-accent)"></div>
            <div class="px-4 sm:px-6 py-2.5 sm:py-4 w-full max-w-sm text-center">
              <p class="cb-text-accent text-base sm:text-xl lg:text-2xl font-heading font-bold tracking-wide">{ceremony.date}</p>
              {ceremony.lunarDate && <p class="cb-text-accent text-xs sm:text-sm font-heading mt-1">{ceremony.lunarDate}</p>}
            </div>
          </div>
        </Reveal>
      </div>
    </div>
  </div>

  <!-- DESKTOP -->
  <div class="hidden lg:flex min-h-screen items-center justify-center px-8 py-14 cb-bg-primary">
    <div class="w-full max-w-5xl overflow-hidden rounded-[40px] border cb-border-accent/25 shadow-2xl relative" style="border-color: color-mix(in srgb, var(--cb-accent) 25%, transparent)">
      <div class="flex min-h-[68vh] relative">
        <div class="w-[52%] min-w-0 relative shrink-0">
          <img src={heroImage} alt="Ảnh nền thiệp cưới" class="w-full h-full object-cover object-center" loading="eager" />
        </div>
        <div class="relative flex-1 min-w-[380px] flex flex-col justify-center px-10 xl:px-16 py-12 cb-bg-primary-dark cb-text-accent overflow-visible">
          <Reveal y={20}>
            <div class="mb-4 text-center">
              <svg class="w-10 h-10 cb-text-accent mx-auto" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.29 1.51 4.04 3 5.5l7 7Z"/></svg>
            </div>
          </Reveal>
          <Reveal delay={0.1}>
            <h2 class="text-xs tracking-[0.4em] uppercase font-bold mb-6 text-center" style="color: color-mix(in srgb, var(--cb-accent) 90%, transparent)">
              {isBrideMode ? "Tân Nương & Tân Lang" : "Tân Lang & Tân Nương"}
            </h2>
          </Reveal>
          <Reveal delay={0.2} class="mb-8">
            <div class="flex items-center justify-between gap-6 w-full min-w-0">
              <h1 class="text-3xl xl:text-4xl font-script cb-text-accent font-bold leading-tight shrink-0 text-left">{firstName}</h1>
              <h1 class="text-3xl xl:text-4xl font-script cb-text-accent font-bold leading-tight shrink-0 text-right">{secondName}</h1>
            </div>
          </Reveal>
          <Reveal delay={0.4}>
            <div class="flex flex-col items-center gap-3 w-full">
              <p class="text-xs tracking-[0.3em] uppercase font-semibold" style="color: color-mix(in srgb, var(--cb-accent) 90%, transparent)">Save the date</p>
              <div class="h-px w-20 mx-auto" style="background-color: color-mix(in srgb, var(--cb-accent) 60%, transparent)"></div>
              <div class="py-4 w-full max-w-sm text-center">
                <p class="cb-text-accent text-xl xl:text-2xl font-heading font-bold tracking-wide">{ceremony.date}</p>
                {ceremony.lunarDate && <p class="cb-text-accent text-sm font-heading mt-1 opacity-80">{ceremony.lunarDate}</p>}
              </div>
            </div>
          </Reveal>
        </div>
      </div>
    </div>
  </div>
</section>
