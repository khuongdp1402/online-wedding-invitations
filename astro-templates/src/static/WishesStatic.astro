---
// Port từ components/templates/classic-burgundy/Wishes.tsx — heading tĩnh;
// form + danh sách lời chúc là WishesIsland.tsx (client:visible).
import Reveal from "./Reveal.astro";
import WishesIsland from "../islands/WishesIsland";

interface Props {
  weddingId: string;
}
const { weddingId } = Astro.props;
---
<section id="loi-chuc" class="relative py-16 sm:py-20 overflow-hidden">
  <div class="container mx-auto max-w-6xl px-4 relative z-10">
    <Reveal>
      <div class="grid gap-16 lg:grid-cols-12 items-start">
        <div class="lg:col-span-12 xl:col-span-5">
          <div class="sticky top-24">
            <p class="text-sm tracking-[0.42em] uppercase cb-text-primary font-bold">Gửi lời chúc &amp; Xác nhận</p>
            <h2 class="mt-4 text-4xl sm:text-5xl font-heading cb-text-body leading-tight" style="color: var(--cb-text)">
              Lời chúc gửi trao,<br />Niềm vui trọn vẹn.
            </h2>
            <p class="mt-6 text-base sm:text-lg cb-text-body leading-relaxed mb-10 font-medium">
              Sự hiện diện và lời chúc của khách mời là món quà vô giá mà chúng mình trân quý nhất.
            </p>
          </div>
        </div>

        <div class="lg:col-span-12 xl:col-span-7">
          <WishesIsland client:visible weddingId={weddingId} />
        </div>
      </div>
    </Reveal>
  </div>
</section>
