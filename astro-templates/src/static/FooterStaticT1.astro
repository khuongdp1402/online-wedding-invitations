---
import Reveal from "./Reveal.astro";

interface Props {
  data: any;
  isFreePlan?: boolean;
}
const { data, isFreePlan } = Astro.props;
---

<section class="bg-paper pb-16 pt-16">
  <Reveal>
    <div class="mx-auto max-w-4xl text-center">
      <div class="mx-auto h-px w-full max-w-6xl bg-[linear-gradient(90deg,transparent,rgba(58,13,26,0.18),transparent)]" />
      <p class="mt-10 text-lg sm:text-xl text-ink-dark font-medium">
        Cảm ơn bạn đã dành thời gian cho ngày trọng đại của
      </p>
      <p class="mt-2 text-2xl sm:text-3xl lg:text-4xl font-script text-burgundy font-bold whitespace-nowrap">
        {data.groom.name} &amp; {data.bride.name}
      </p>
      <p class="mt-4 text-sm sm:text-base tracking-[0.32em] uppercase text-ink/70 font-semibold">Hẹn gặp bạn</p>
      {isFreePlan && (
        <a 
          href="https://thiepcuoi.studio"
          target="_blank" 
          rel="noopener noreferrer"
          class="mt-6 text-ink/70 inline-block text-xs font-medium tracking-wide uppercase opacity-70 hover:opacity-100 transition-opacity"
        >
          Thiết kế bởi <b>ThiepCuoi.Studio</b>
        </a>
      )}
    </div>
  </Reveal>
</section>
