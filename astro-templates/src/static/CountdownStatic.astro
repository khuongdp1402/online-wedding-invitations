---
// Port từ components/templates/classic-burgundy/Countdown.tsx — heading +
// ảnh là tĩnh; phần đếm số (setInterval) là CountdownIsland.tsx (client:visible).
import Reveal from "./Reveal.astro";
import CountdownIsland from "../islands/CountdownIsland";
import type { WeddingData } from "@/types/template";

interface Props {
  wedding: WeddingData;
  mode: "groom" | "bride";
}
const { wedding, mode } = Astro.props;
const ceremony = mode === "bride" ? wedding.brideCeremony : wedding.groomCeremony;
const countdownImage = wedding.gallery[1] || "";
---
<section id="countdown" class="relative py-16 sm:py-20 overflow-hidden">
  <div class="container mx-auto max-w-7xl px-4 relative z-10">
    <div class="grid gap-16 lg:grid-cols-12 items-center">
      <div class="lg:col-span-6">
        <Reveal x={-30}>
          {countdownImage && (
            <div class="relative aspect-[4/5] sm:aspect-square rounded-t-full overflow-hidden border-[8px] border-white shadow-2xl transition-transform hover:scale-[1.01] duration-700">
              <img src={countdownImage} alt="Together" class="w-full h-full object-cover scale-105" loading="lazy" />
              <div class="absolute inset-0 opacity-5" style="background-color: var(--cb-primary)"></div>
            </div>
          )}
        </Reveal>
      </div>
      <div class="lg:col-span-6">
        <Reveal>
          <div class="text-center lg:text-left mb-12">
            <h2 class="cb-text-primary uppercase tracking-[0.25em] text-lg sm:text-xl font-bold mb-6">Đếm ngược ngày trọng đại</h2>
            <div class="h-px w-24 bg-gradient-to-r from-transparent via-[var(--cb-accent)] to-transparent mx-auto lg:mx-0 my-8 opacity-60"></div>
            <p class="mt-8 text-4xl sm:text-5xl font-heading cb-text-primary font-bold tracking-tight">{ceremony.date}</p>
          </div>
        </Reveal>
        <Reveal delay={0.1} y={20}>
          <CountdownIsland client:visible targetISO={ceremony.date} />
        </Reveal>
        <Reveal delay={0.3} y={20}>
          <div class="mt-16 text-center lg:text-left italic cb-text-body text-lg font-heading opacity-70">
            &ldquo;Dù đi đâu, làm gì, chỉ cần chúng ta bên nhau.&rdquo;
          </div>
        </Reveal>
      </div>
    </div>
  </div>
</section>
