---
// Port 1:1 từ components/templates/classic-burgundy/ModeSwitcher.tsx —
// component gốc đã là "pointer-events-none" (chỉ hiển thị nhãn, không phải
// nút chuyển mode) nên port thẳng không cần đổi gì.
interface Props {
  mode: "groom" | "bride";
}
const { mode } = Astro.props;
---
<div class="fixed top-4 right-4 z-50">
  <div class="flex items-center gap-2 px-4 py-2 bg-white/90 backdrop-blur-sm border-2 rounded-full shadow-lg pointer-events-none cb-border-primary" style="border-color: color-mix(in srgb, var(--cb-primary) 20%, transparent)">
    <svg class="w-4 h-4 cb-text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2c1 3 3 4 6 5-3 1-5 3-6 6-1-3-3-5-6-6 3-1 5-2 6-5Z"/></svg>
    <span class="text-sm font-heading font-semibold cb-text-primary">{mode === "bride" ? "Nhà Gái" : "Nhà Trai"}</span>
  </div>
</div>
