---
// Port từ components/templates/classic-burgundy/Gallery.tsx — heading tĩnh;
// lưới ảnh + lightbox là GalleryIsland.tsx (client:visible, bắt buộc JS).
import Reveal from "./Reveal.astro";
import GalleryIsland from "../islands/GalleryIsland";

interface Props {
  gallery: string[];
}
const { gallery } = Astro.props;
---
<section id="anh" class="relative py-24 lg:py-32 overflow-hidden">
  <div class="mx-auto max-w-7xl px-4">
    <Reveal>
      <div class="text-center mb-20">
        <h2 class="cb-text-primary uppercase tracking-[0.25em] text-lg sm:text-xl font-bold mb-6">Bộ ảnh kỷ niệm</h2>
        <div class="h-px w-24 bg-gradient-to-r from-transparent via-[var(--cb-accent)] to-transparent mx-auto my-8 opacity-60"></div>
        <p class="mt-8 text-3xl sm:text-4xl font-heading cb-text-body italic opacity-90 leading-tight">
          &ldquo;Những khoảnh khắc chúng mình yêu nhất.&rdquo;
        </p>
      </div>
    </Reveal>

    <GalleryIsland client:visible gallery={gallery} />

    <Reveal delay={0.1}>
      <div class="mt-16 text-center text-base sm:text-lg cb-text-body italic font-medium opacity-60">
        Tình yêu không chỉ là nhìn nhau, mà là cùng nhau nhìn về một hướng.
      </div>
    </Reveal>
  </div>
</section>
