---
// Port từ components/templates/classic-burgundy/Quote.tsx.
// guestName/guestSalutation là cá nhân hoá theo URL (?name=/?salutation=) —
// HTML build sẵn dùng chung mọi khách nên render placeholder "quý khách" ở
// đây, rồi 1 script nhỏ (guest-personalize.js) thay text lúc trang tải nếu
// URL có ?name=/?guest=/?salutation=/?xung_ho= (khác bản gốc, nơi Next đọc
// searchParams server-side rồi truyền qua props).
import Reveal from "./Reveal.astro";
import type { WeddingData } from "@/types/template";

interface Props {
  wedding: WeddingData;
  mode: "groom" | "bride";
}
const { wedding, mode } = Astro.props;
const isBrideMode = mode === "bride";
const photo1 = wedding.gallery[4] || "";
const photo2 = wedding.gallery[5] || "";
---
<section class="relative sm:py-40 overflow-hidden">
  <div class="container mx-auto max-w-7xl px-4 relative z-10">
    {photo1 && photo2 && (
      <div class="lg:hidden grid grid-cols-2 gap-4 sm:gap-6 max-w-sm mx-auto mb-8 sm:mb-10">
        <Reveal x={-20}>
          <div class="relative aspect-[3/4] rounded-2xl overflow-hidden border-[4px] border-white shadow-xl rotate-[-3deg]">
            <img src={photo1} alt={isBrideMode ? "Cô dâu" : "Chú rể"} class="w-full h-full object-cover" loading="lazy" />
          </div>
        </Reveal>
        <Reveal x={20}>
          <div class="relative aspect-[3/4] rounded-2xl overflow-hidden border-[4px] border-white shadow-xl rotate-[3deg] mt-6">
            <img src={photo2} alt={isBrideMode ? "Chú rể" : "Cô dâu"} class="w-full h-full object-cover" loading="lazy" />
          </div>
        </Reveal>
      </div>
    )}

    <div class="relative grid grid-cols-12 gap-8 items-center">
      {photo1 && (
        <div class="hidden lg:block lg:col-span-4">
          <Reveal x={-40}>
            <div class="relative aspect-[3/4] rounded-full overflow-hidden border-[6px] border-white shadow-2xl rotate-[-2deg] grayscale-[0.2] hover:grayscale-0 transition-all duration-700">
              <img src={photo1} alt="Portrait" class="w-full h-full object-cover scale-110" loading="lazy" />
            </div>
          </Reveal>
        </div>
      )}

      <div class="col-span-12 lg:col-span-4 text-center px-4 space-y-6 sm:space-y-8">
        <Reveal>
          <div class="mb-6 flex justify-center opacity-30">
            <svg class="w-10 h-10" viewBox="0 0 24 24" style="color: var(--cb-primary); fill: var(--cb-primary)"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.29 1.51 4.04 3 5.5l7 7Z"/></svg>
          </div>
          <p class="cb-text-primary text-sm sm:text-base uppercase tracking-[0.35em] font-bold mb-4">Trân trọng kính mời</p>
          <p class="cb-text-body text-lg sm:text-xl font-heading font-medium mb-4" style="color: var(--cb-text)">
            <span class="font-bold" data-guest-invitee-label>quý khách</span> tới dự buổi tiệc chung vui cùng gia đình chúng tôi.
          </p>
          <p class="cb-text-body text-lg sm:text-xl font-heading font-medium mb-8" style="color: var(--cb-text)">
            Sự hiện diện của <span class="font-bold" data-guest-salutation-label>quý khách</span> là niềm vinh hạnh lớn lao cho gia đình chúng tôi.
          </p>
          {wedding.quote && (
            <p class="cb-text-body text-base sm:text-lg italic font-medium mb-4" style="color: var(--cb-text)">&ldquo;{wedding.quote}&rdquo;</p>
          )}
          <div class="h-px w-24 bg-gradient-to-r from-transparent via-[var(--cb-accent)] to-transparent mx-auto my-8"></div>
        </Reveal>
      </div>

      {photo2 && (
        <div class="hidden lg:block lg:col-span-4">
          <Reveal x={40}>
            <div class="relative aspect-[3/4] rounded-t-full overflow-hidden border-[6px] border-white shadow-2xl rotate-[2deg] grayscale-[0.2] hover:grayscale-0 transition-all duration-700 mt-12">
              <img src={photo2} alt="Portrait" class="w-full h-full object-cover scale-110" loading="lazy" />
            </div>
          </Reveal>
        </div>
      )}
    </div>
  </div>

  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 pointer-events-none select-none italic font-heading">
    <span class="block text-[4rem] sm:text-[7rem] lg:text-[15rem] opacity-10 sm:opacity-[0.06] lg:opacity-[0.03] cb-text-primary">Forever</span>
  </div>
</section>
