---
import Reveal from "./Reveal.astro";

interface Props {
  data: any;
  isBrideMode?: boolean;
}
const { data } = Astro.props;
---

<section id="dia-diem" class="relative lg:py-32 py-16 bg-paper">
  <div class="mx-auto max-w-6xl px-4">
    <Reveal>
      <div class="grid gap-16 md:grid-cols-12 md:gap-20 items-center">
        <div class="md:col-span-5 text-center md:text-left">
          <h2 class="text-burgundy font-bold uppercase tracking-[0.3em] text-base sm:text-lg mb-6">Địa điểm tổ chức</h2>
          <h3 class="text-4xl sm:text-5xl lg:text-6xl font-heading text-ink-dark font-bold leading-tight mb-6">
            {data.ceremony.venueName}
          </h3>
          <p class="text-xl sm:text-2xl text-ink leading-relaxed mb-10 max-w-md mx-auto md:mx-0 font-medium">
            {data.ceremony.address}
          </p>

          <div class="flex flex-col gap-4">
            <a
              href={data.ceremony.googleMapsUrl}
              target="_blank"
              rel="noreferrer"
              class="cb-scale-btn inline-flex items-center justify-center px-10 py-4 bg-burgundy text-white text-base tracking-[0.3em] uppercase rounded-none hover:bg-burgundy-dark transition-all shadow-lg font-bold"
            >
              Mở Google Maps
            </a>

            <a
              href="#loi-chuc"
              class="cb-scale-btn inline-flex items-center justify-center px-10 py-4 border border-burgundy/20 bg-transparent text-burgundy text-sm tracking-[0.3em] uppercase transition-all font-bold hover:bg-[rgba(128,0,32,0.05)]"
            >
              Xác nhận tham dự
            </a>
          </div>
        </div>

        <div class="md:col-span-7">
          <div class="content-card !p-0 overflow-hidden border border-gold/20 shadow-2xl scale-[1.02]">
            <iframe
              title="Google Maps"
              src={data.ceremony.googleMapsEmbedUrl}
              class="h-[400px] w-full lg:h-[480px] grayscale-[0.2] contrast-[1.1]"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              allowfullscreen
            ></iframe>
          </div>
        </div>
      </div>
    </Reveal>
  </div>
</section>

<style>
  .cb-scale-btn {
    transition: transform 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .cb-scale-btn:hover {
    transform: scale(1.02);
  }
  .cb-scale-btn:active {
    transform: scale(0.98);
  }
</style>
