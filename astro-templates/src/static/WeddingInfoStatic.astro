---
// Port từ components/templates/classic-burgundy/WeddingInfo.tsx.
// Bỏ useEditOverlay/editSlotClass; next/image -> <img>.
import Reveal from "./Reveal.astro";
import type { WeddingData } from "@/types/template";

interface Props {
  wedding: WeddingData;
  mode: "groom" | "bride";
}
const { wedding, mode } = Astro.props;
const isBrideMode = mode === "bride";
const ceremony = isBrideMode ? wedding.brideCeremony : wedding.groomCeremony;
const firstName = isBrideMode ? wedding.brideName : wedding.groomName;
const secondName = isBrideMode ? wedding.groomName : wedding.brideName;
const firstParents = isBrideMode ? wedding.brideParents : wedding.groomParents;
const secondParents = isBrideMode ? wedding.groomParents : wedding.brideParents;
const photo1 = wedding.gallery[2] || "";
const photo2 = wedding.gallery[3] || "";
---
<section id="thong-tin" class="relative overflow-hidden bg-white">
  <div class="mx-auto max-w-6xl px-4 relative z-10">
    <Reveal y={16}>
      <div class="text-center py-8 sm:py-10">
        <p class="text-lg sm:text-xl font-heading cb-text-primary italic font-medium opacity-90">&ldquo;Trăm năm tình viên mãn&rdquo;</p>
        <p class="text-lg sm:text-xl font-heading cb-text-primary italic font-medium opacity-90 mt-2">&ldquo;Bạc đầu nghĩa phu thê&rdquo;</p>
      </div>
    </Reveal>

    <div class="grid grid-cols-[1fr_auto_1fr] gap-2 md:gap-12 mb-12 sm:mb-20 px-0 items-center">
      <Reveal x={-20}>
        <div class="space-y-4 text-center border-t pt-6" style="border-color: color-mix(in srgb, var(--cb-accent) 20%, transparent)">
          <div class="flex flex-col items-center gap-2 mb-2">
            <p class="text-[0.6rem] sm:text-[0.7rem] uppercase tracking-[0.2em] cb-text-primary font-bold whitespace-nowrap">{isBrideMode ? "Nhà gái" : "Nhà trai"}</p>
            <div class="w-1 h-1 rounded-full" style="background-color: color-mix(in srgb, var(--cb-accent) 40%, transparent)"></div>
          </div>
          <div class="space-y-0.5">
            <p class="text-base sm:text-xl cb-text-body font-heading font-medium leading-relaxed whitespace-nowrap" style="color: var(--cb-text)">{firstParents.father}</p>
            <p class="text-base sm:text-xl cb-text-body font-heading font-medium leading-relaxed whitespace-nowrap" style="color: var(--cb-text)">{firstParents.mother}</p>
          </div>
        </div>
      </Reveal>
      <div class="h-24 w-px mx-auto" style="background-color: color-mix(in srgb, var(--cb-accent) 20%, transparent)"></div>
      <Reveal x={20}>
        <div class="space-y-4 text-center border-t pt-6" style="border-color: color-mix(in srgb, var(--cb-accent) 20%, transparent)">
          <div class="flex flex-col items-center gap-2 mb-2">
            <p class="text-[0.6rem] sm:text-[0.7rem] uppercase tracking-[0.2em] cb-text-primary font-bold whitespace-nowrap">{isBrideMode ? "Nhà trai" : "Nhà gái"}</p>
            <div class="w-1 h-1 rounded-full" style="background-color: color-mix(in srgb, var(--cb-accent) 40%, transparent)"></div>
          </div>
          <div class="space-y-0.5">
            <p class="text-base sm:text-xl cb-text-body font-heading font-medium leading-relaxed whitespace-nowrap" style="color: var(--cb-text)">{secondParents.father}</p>
            <p class="text-base sm:text-xl cb-text-body font-heading font-medium leading-relaxed whitespace-nowrap" style="color: var(--cb-text)">{secondParents.mother}</p>
          </div>
        </div>
      </Reveal>
    </div>

    <div class="max-w-4xl mx-auto">
      <Reveal y={30}>
        <div class="text-center space-y-6 relative">
          {photo1 && photo2 && (
            <div class="relative h-64 sm:h-80 mb-8 mx-auto w-full max-w-md">
              <div class="absolute top-0 left-0 w-48 h-64 rounded-2xl overflow-hidden shadow-2xl border-4 border-white -rotate-6 z-0 transition-transform hover:z-20 hover:scale-105 duration-500">
                <img src={photo1} alt={isBrideMode ? "Cô dâu" : "Chú rể"} class="w-full h-full object-cover" loading="lazy" />
              </div>
              <div class="absolute top-10 right-0 w-48 h-64 rounded-2xl overflow-hidden shadow-2xl border-4 border-white rotate-6 z-10 transition-transform hover:z-20 hover:scale-105 duration-500">
                <img src={photo2} alt={isBrideMode ? "Chú rể" : "Cô dâu"} class="w-full h-full object-cover" loading="lazy" />
              </div>
            </div>
          )}

          <div class="space-y-5">
            <div class="flex flex-col gap-3 w-full max-w-4xl mx-auto">
              <div class="text-left">
                <span class="text-3xl sm:text-5xl lg:text-6xl font-script cb-text-primary font-bold leading-relaxed drop-shadow-sm">{firstName}</span>
                <span class="block text-base sm:text-lg font-heading cb-text-body font-bold tracking-[0.2em] uppercase mt-1" style="color: var(--cb-text)">
                  {isBrideMode ? "Ái Nữ" : "Trưởng Nam"}
                </span>
              </div>
              <div class="text-right">
                <span class="text-3xl sm:text-5xl lg:text-6xl font-script cb-text-primary font-bold leading-relaxed drop-shadow-sm">{secondName}</span>
                <span class="block text-base sm:text-lg font-heading cb-text-body font-bold tracking-[0.2em] uppercase mt-1" style="color: var(--cb-text)">
                  {isBrideMode ? "Trưởng Nam" : "Ái Nữ"}
                </span>
              </div>
            </div>

            <div class="h-px w-32 bg-gradient-to-r from-transparent via-[var(--cb-accent)] to-transparent mx-auto opacity-60"></div>

            <div class="space-y-4 mt-4">
              <div class="flex flex-wrap items-center justify-center gap-4 sm:gap-6">
                <div class="text-center">
                  <p class="cb-text-body text-xs sm:text-sm uppercase tracking-wider font-semibold mb-0.5 opacity-70" style="color: var(--cb-text)">Giờ làm lễ</p>
                  <p class="text-4xl sm:text-5xl font-heading cb-text-primary font-bold">{ceremony.ceremonyTime}</p>
                </div>
                <div class="w-px h-10 hidden sm:block" style="background-color: color-mix(in srgb, var(--cb-accent) 30%, transparent)"></div>
                <div class="text-center">
                  <p class="cb-text-body text-xs sm:text-sm uppercase tracking-wider font-semibold mb-0.5 opacity-70" style="color: var(--cb-text)">Giờ nhập tiệc</p>
                  <p class="text-4xl sm:text-5xl font-heading cb-text-primary font-bold">{ceremony.receptionTime}</p>
                </div>
              </div>

              <div class="space-y-1">
                <p class="text-3xl sm:text-4xl cb-text-body font-heading font-bold tracking-wide" style="color: var(--cb-text)">{ceremony.date}</p>
                {ceremony.lunarDate && <p class="text-xl cb-text-body font-semibold">{ceremony.lunarDate}</p>}
              </div>
            </div>

            <div class="pt-6 border-t inline-block px-8 mt-2" style="border-color: color-mix(in srgb, var(--cb-accent) 20%, transparent)">
              <p class="text-base uppercase tracking-[0.4em] cb-text-primary font-bold mb-3">Địa điểm</p>
              <p class="text-4xl cb-text-body font-heading font-black tracking-tight mb-2 leading-tight" style="color: var(--cb-text)">{ceremony.venue}</p>
              <p class="text-xl cb-text-body font-bold max-w-[500px] mx-auto leading-relaxed">{ceremony.address}</p>
            </div>
          </div>
        </div>
      </Reveal>
    </div>
  </div>

  <div class="absolute top-20 right-[-5%] pointer-events-none select-none font-heading rotate-12">
    <span class="block text-[4rem] sm:text-[10rem] lg:text-[20rem] opacity-10 sm:opacity-[0.05] lg:opacity-[0.03] cb-text-primary">Love</span>
  </div>
</section>
