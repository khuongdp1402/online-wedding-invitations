---
import type { WeddingData } from "@/lib/template-registry";
import Reveal from "./Reveal.astro";

interface Props {
  wedding: WeddingData;
  mode: "groom" | "bride";
}
const { wedding, mode } = Astro.props;
const isBrideMode = mode === "bride";
const firstName = isBrideMode ? wedding.brideName : wedding.groomName;
const secondName = isBrideMode ? wedding.groomName : wedding.brideName;

// Use wedding gallery for photos (Slot 1 & 2 as polaroids)
const polaroid1 = wedding.gallery[0] || "https://images.unsplash.com/photo-1511285560929-80b456fea0bc?q=80&w=600";
const polaroid2 = wedding.gallery[1] || "https://images.unsplash.com/photo-1583939003579-730e3918a45a?q=80&w=600";
---
<div class="relative pt-24 pb-12 px-6 flex flex-col items-center">
  {/* Names Header */}
  <div class="text-center z-10 mb-16">
    <p class="text-sm tracking-[0.3em] uppercase opacity-60 mb-8">Lễ thành hôn</p>
    <h1 class="font-script text-6xl text-[var(--primary)] leading-tight">
      {firstName}
      <span class="block text-2xl my-2">&amp;</span>
      {secondName}
    </h1>
  </div>

  {/* Polaroid Section */}
  <div class="relative w-full h-[400px] flex justify-center">
    {/* Photo 1 (Tilted Left) */}
    <Reveal x={-40} class="absolute z-20 w-[200px]">
      <div class="polaroid-frame" style="transform: rotate(-8deg)">
        <img src={polaroid1} alt={firstName} class="w-full aspect-square object-cover" width="200" height="200" loading="lazy" />
        <p class="font-script text-lg text-center mt-3 opacity-70">{firstName}</p>
      </div>
    </Reveal>

    {/* Photo 2 (Tilted Right) */}
    <Reveal x={50} y={80} delay={0.2} class="absolute z-10 w-[200px]">
      <div class="polaroid-frame" style="transform: rotate(6deg)">
        <img src={polaroid2} alt={secondName} class="w-full aspect-square object-cover" width="200" height="200" loading="lazy" />
        <p class="font-script text-lg text-center mt-3 opacity-70">{secondName}</p>
      </div>
    </Reveal>
  </div>
  
  {/* Decorative leaf */}
  <div class="absolute top-1/2 -right-10 opacity-20 transform rotate-45 pointer-events-none">
     <svg width="150" height="150" viewBox="0 0 100 100" class="fill-[var(--secondary)]">
        <path d="M50,10 C60,40 90,50 50,90 C10,50 40,40 50,10" />
     </svg>
  </div>
</div>
