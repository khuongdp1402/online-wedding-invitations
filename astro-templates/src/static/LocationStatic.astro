---
// Port từ components/templates/classic-burgundy/Location.tsx.
// motion.a whileHover/whileTap -> CSS class .cb-scale-btn (hover/active thuần).
import Reveal from "./Reveal.astro";
import type { WeddingData } from "@/types/template";

interface Props {
  wedding: WeddingData;
  mode: "groom" | "bride";
}
const { wedding, mode } = Astro.props;
const isBrideMode = mode === "bride";
const ceremony = isBrideMode ? wedding.brideCeremony : wedding.groomCeremony;
---
<section id="dia-diem" class="relative lg:py-32">
  <div class="mx-auto max-w-6xl px-4">
    <Reveal>
      <div class="grid gap-16 md:grid-cols-12 md:gap-20 items-center">
        <div class="md:col-span-5 text-center md:text-left">
          <h2 class="cb-text-primary uppercase tracking-[0.25em] text-base sm:text-lg mb-6 font-bold">Địa điểm tổ chức</h2>
          <h3 class="text-4xl sm:text-5xl lg:text-6xl font-heading cb-text-body font-bold leading-tight mb-6" style="color: var(--cb-text)">{ceremony.venue}</h3>
          <p class="text-xl sm:text-2xl cb-text-body leading-relaxed mb-10 max-w-md mx-auto md:mx-0 font-medium">{ceremony.address}</p>

          <div class="flex flex-col gap-4">
            {ceremony.googleMapsUrl && (
              <a
                href={ceremony.googleMapsUrl}
                target="_blank"
                rel="noreferrer"
                class="cb-scale-btn inline-flex items-center justify-center px-10 py-4 cb-bg-primary text-white text-base tracking-[0.3em] uppercase hover:opacity-90 transition-all shadow-lg font-bold"
              >
                Mở Google Maps
              </a>
            )}
            <a
              href="#loi-chuc"
              class="cb-scale-btn inline-flex items-center justify-center px-10 py-4 border bg-transparent cb-text-primary text-sm tracking-[0.3em] uppercase transition-all font-bold"
              style="border-color: color-mix(in srgb, var(--cb-primary) 20%, transparent)"
            >
              Xác nhận tham dự
            </a>
          </div>
        </div>

        <div class="md:col-span-7">
          {ceremony.googleMapsUrl && (
            <div class="bg-white shadow-[0_10px_30px_-5px_rgba(0,0,0,0.05)] border rounded-2xl p-0 overflow-hidden shadow-2xl scale-[1.02]" style="border-color: color-mix(in srgb, var(--cb-accent) 10%, transparent)">
              <iframe
                title="Google Maps"
                src={`https://maps.google.com/maps?q=${encodeURIComponent(ceremony.address)}&output=embed`}
                class="h-[400px] w-full lg:h-[480px] grayscale-[0.2] contrast-[1.1]"
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                allowfullscreen
              ></iframe>
            </div>
          )}
        </div>
      </div>
    </Reveal>
  </div>
</section>

<style>
  .cb-scale-btn {
    transition: transform 0.15s ease-out;
  }
  .cb-scale-btn:hover {
    transform: scale(1.02);
  }
  .cb-scale-btn:active {
    transform: scale(0.98);
  }
</style>
