# Database (Neon / Supabase PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# NextAuth (Docker compose map 3001:3000 → dùng http://localhost:3001; dev `npm run dev` thường là 3000)
NEXTAUTH_URL="http://localhost:3001"
# BẮT BUỘC ở production (thiếu thì app dừng khi khởi động). Sinh bằng: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"

# Google OAuth (để ẩn nút Google khi chưa cấu hình, set = false)
NEXT_PUBLIC_GOOGLE_ENABLED="false"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# UploadThing (tuỳ chọn)
UPLOADTHING_SECRET=""
UPLOADTHING_APP_ID=""

# S3 tương thích (MinIO self-host). 
# Bật MinIO bằng lệnh: docker compose --profile storage up -d
# Service `createbuckets` tự tạo bucket 'wedding-uploads' với policy anonymous
# 'download' (chỉ đọc file theo URL, KHÔNG cho liệt kê toàn bộ ảnh).
# Không đặt policy 'public' (cho phép liệt kê mọi ảnh cưới đã upload).
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="wedding-uploads"
S3_ACCESS_KEY_ID="minio"
S3_SECRET_ACCESS_KEY="minio_secret_change_me"
# URL trình duyệt dùng để tải file. Nếu chạy local dùng chung endpoint.
S3_PUBLIC_URL="http://localhost:9000"
# Path-style bắt buộc với MinIO
S3_FORCE_PATH_STYLE="true"

# Asset template (ảnh theme, nhạc, font ~550 MB) trên MinIO — bucket riêng.
# Dùng cho script: node scripts/upload-assets-to-minio.cjs [--dry-run]
# (tự tạo bucket, policy anonymous chỉ s3:GetObject — không ListBucket, CORS GET/HEAD).
# vd. ASSETS_S3_ENDPOINT="https://winglove.phukhuong.io.vn"
ASSETS_S3_ENDPOINT=""
ASSETS_S3_REGION="us-east-1"
ASSETS_S3_ACCESS_KEY_ID=""
ASSETS_S3_SECRET_ACCESS_KEY=""
ASSETS_S3_BUCKET="wedding-assets"
# Đặt sau khi đã upload xong: app (middleware, đọc lúc RUNTIME — chỉ cần restart,
# không cần build lại) sẽ redirect 307 các request /images/themes/, /music/,
# /font/... sang URL này. Để trống = phục vụ file trong public/ như cũ (rollback).
# vd. ASSETS_BASE_URL="https://winglove.phukhuong.io.vn/wedding-assets"
ASSETS_BASE_URL=""


# Thông tin tài khoản ngân hàng nhận tiền (chuyển khoản + QR VietQR).
# Phải khớp đúng tài khoản đã kết nối Casso ở dưới để đối soát tự động hoạt
# động. Xem hướng dẫn đầy đủ: docs/setup-payment-notify.md
BANK_NAME=""
BANK_ACCOUNT_NUMBER=""
BANK_ACCOUNT_HOLDER=""

# Casso (webhook biến động số dư ngân hàng)
# BẮT BUỘC phải đặt: webhook này publish được thiệp nên nếu thiếu biến này
# route sẽ từ chối mọi request (503).
CASSO_WEBHOOK_SECRET=""

# Telegram (thông báo khi có giao dịch thanh toán) — tuỳ chọn, không đặt
# thì hệ thống chỉ log ra console, không chặn thanh toán.
# Xem hướng dẫn đầy đủ: docs/setup-payment-notify.md
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Resend (Email)
RESEND_API_KEY=""

# Admin
ADMIN_API_KEY="your-admin-api-key-here"
# Tài khoản admin do seed tạo lần đầu. Để trống ADMIN_PASSWORD thì seed sinh
# mật khẩu ngẫu nhiên và in ra console 1 lần. Seed không ghi đè mật khẩu admin đã có.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3001"
NEXT_PUBLIC_APP_NAME="Thiệp Cưới Online"
