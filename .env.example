# Database (Neon / Supabase PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# NextAuth (Docker compose map 3001:3000 → dùng http://localhost:3001; dev `npm run dev` thường là 3000)
NEXTAUTH_URL="http://localhost:3001"
NEXTAUTH_SECRET="your-secret-here"

# Google OAuth (để ẩn nút Google khi chưa cấu hình, set = false)
NEXT_PUBLIC_GOOGLE_ENABLED="false"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# UploadThing (tuỳ chọn)
UPLOADTHING_SECRET=""
UPLOADTHING_APP_ID=""

# S3 tương thích (MinIO self-host). 
# Bật MinIO bằng lệnh: docker compose --profile storage up -d
# Sau đó truy cập http://localhost:9001 tạo bucket tên 'wedding-uploads' 
# và set Access Policy là 'public' (hoặc setup CORS).
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="wedding-uploads"
S3_ACCESS_KEY_ID="minio"
S3_SECRET_ACCESS_KEY="minio_secret_change_me"
# URL trình duyệt dùng để tải file. Nếu chạy local dùng chung endpoint.
S3_PUBLIC_URL="http://localhost:9000"
# Path-style bắt buộc với MinIO
S3_FORCE_PATH_STYLE="true"


# Thông tin tài khoản ngân hàng nhận tiền (chuyển khoản + QR VietQR).
# Phải khớp đúng tài khoản đã kết nối Casso ở dưới để đối soát tự động hoạt
# động. Xem hướng dẫn đầy đủ: docs/setup-payment-notify.md
BANK_NAME=""
BANK_ACCOUNT_NUMBER=""
BANK_ACCOUNT_HOLDER=""

# Casso (webhook biến động số dư ngân hàng)
# BẮT BUỘC phải đặt: webhook này publish được thiệp nên nếu thiếu biến này
# route sẽ từ chối mọi request (503).
CASSO_WEBHOOK_SECRET=""

# Telegram (thông báo khi có giao dịch thanh toán) — tuỳ chọn, không đặt
# thì hệ thống chỉ log ra console, không chặn thanh toán.
# Xem hướng dẫn đầy đủ: docs/setup-payment-notify.md
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Resend (Email)
RESEND_API_KEY=""

# Admin
ADMIN_API_KEY="your-admin-api-key-here"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3001"
NEXT_PUBLIC_APP_NAME="Thiệp Cưới Online"
